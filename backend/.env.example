PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_STORAGE=./data/app-latin.sqlite
# Para usar PostgreSQL (por ejemplo Neon), define DATABASE_URL. Tiene prioridad
# sobre DATABASE_STORAGE salvo cuando este último vale :memory: en las pruebas.
DATABASE_URL=
DATABASE_SSL=true
AI_PROVIDER=mock
AI_MODEL=gpt-5.5
OPENAI_API_KEY=
AI_FALLBACK_TO_MOCK=true
APP_PASSWORD=
SESSION_SECRET=
SESSION_DURATION_DAYS=30
