{
 "name": "backend",
 "version": "1.0.0",
 "description": "Backend de la aplicacion de latin",
 "type": "module",
 "main": "src/app.js",
 "scripts": {
  "start": "node src/app.js",
  "dev": "node --watch src/app.js",
  "db:sync": "node src/database/sync.js",
  "vocabulary:dry-run": "node scripts/importFamiliaRomanaVocabulary.js --dry-run",
  "vocabulary:import": "node scripts/importFamiliaRomanaVocabulary.js",
  "vocabulary:backfill": "node scripts/backfillLegacyVocabularyProgress.js",
  "vocabulary:export-seed": "node scripts/exportVocabularySeed.js",
  "adaptive:demo": "node scripts/simulateAdaptiveSession.js",
  "adaptive:profiles": "node scripts/simulateVocabularyProfiles.js",
  "test": "node --test --test-concurrency=1 test/*.test.js",
  "lint": "eslint .",
  "lint:fix": "eslint . --fix",
  "format": "prettier . --write"
 },
 "keywords": [
  "node",
  "express",
  "api",
  "backend",
  "tareas"
 ],
 "author": "",
 "license": "ISC",
 "dependencies": {
  "cors": "^2.8.6",
  "dotenv": "^17.4.2",
  "express": "^5.2.1",
  "pg": "^8.16.3",
  "pg-hstore": "^2.3.4",
  "sequelize": "^6.37.8"
 },
 "devDependencies": {
  "eslint": "^10.6.0",
  "eslint-config-prettier": "^10.1.8",
  "prettier": "^3.9.4",
  "sqlite3": "^5.1.7"
 }
}
